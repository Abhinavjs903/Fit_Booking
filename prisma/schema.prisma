
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  memberCode   String   @unique
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessionsCreated Session[] @relation("SessionCreator")
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  fineRecords Fine[] @relation("UserFines")
finesWaived Fine[] @relation("FineWaiver")
otpChallenges OtpChallenge[]
}

model Session {
  id          String   @id @default(cuid())
  startsAt    DateTime @unique
  capacity    Int      @default(20)
  createdAt   DateTime @default(now())
  createdById String

  createdBy      User            @relation("SessionCreator", fields: [createdById], references: [id])
  bookings       Booking[]
  waitlistEntries WaitlistEntry[]
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  sessionId   String
  status      BookingStatus @default(CONFIRMED)
  checkInCode String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
  fine Fine?
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
  @@index([sessionId, createdAt])
}

model Fine {
  id         String     @id @default(cuid())
  bookingId  String     @unique
  userId     String
  amount     Int        @default(20)
  status     FineStatus @default(UNPAID)
  reason     String     @default("NO_SHOW")
  waivedById String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  user     User    @relation("UserFines", fields: [userId], references: [id])
  waivedBy User?   @relation("FineWaiver", fields: [waivedById], references: [id])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}